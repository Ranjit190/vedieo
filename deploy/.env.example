# Public IP of the Oracle VM — announced in ICE candidates so browsers
# know where to send/receive media. MUST be the public IP, not the
# 10.x.x.x private one (the auto-detect cannot see it behind Oracle's NAT).
ANNOUNCED_IP=143.47.0.0

# HTTPS hostname for signaling. sslip.io needs no signup: the hostname
# <public-ip>.sslip.io automatically resolves to that IP and Caddy will
# obtain a Let's Encrypt certificate for it. A DuckDNS name works too.
DOMAIN=143.47.0.0.sslip.io

# Exact origin of the Vercel frontend (no trailing slash) for CORS.
CLIENT_ORIGIN=https://your-app.vercel.app

# Optional overrides
# RTC_MIN_PORT=40000
# RTC_MAX_PORT=40100
# NUM_WORKERS=2
